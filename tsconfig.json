{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "Backend/src",
    "outDir": "Backend/dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "Backend/src/**/*"
  ]
}