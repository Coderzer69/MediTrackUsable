DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=3000

JWT_SECRET="your_jwt_secret_key"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Server-side Gemini AI Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Prescription emails via Brevo (optional; emails are skipped when unset)
BREVO_API_KEY="your_brevo_api_key"
EMAIL_FROM_ADDRESS="verified-sender@yourdomain.com"
EMAIL_FROM_NAME="MediTrack"
APP_URL="http://localhost:5173"

# ElevenLabs: doctor dictation (Scribe) and patient voice recordings (optional)
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
# ELEVENLABS_STT_MODEL="scribe_v2_medical"
# ELEVENLABS_TTS_MODEL="eleven_v4"
# ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"
